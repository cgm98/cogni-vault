# ==========================================
# Cogni-Vault - Git Ignore Configuration
# ==========================================

# 1. Dependencias (Node / Workspaces)
node_modules/
.pnp
.pnp.js

# 2. Compilados y artefactos de build
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# 3. Base de datos SQLite y archivos de persistencia local
# cogni_vault.db excede 100MB (límite de GitHub) y contiene datos de usuario/vectores
db/*.db
db/*.db-wal
db/*.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 4. Almacenamiento de archivos y subidas de usuario en runtime (Uploads)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 5. Carpetas temporales y cachés
temp/
tmp/
.cache/
.vite/
.turbo/

# 6. Variables de entorno y secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# 7. Logs de ejecución y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 8. Reportes de pruebas y cobertura
coverage/
.nyc_output/

# 9. Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
*.local

# IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
